# Copiar a /home/deploy/apps/tcysPedidosSucursales/shared/.env y chmod 600.
# Todos los valores sensibles son placeholders deliberadamente invalidos.
DJANGO_ENV=production
SECRET_KEY=<REEMPLAZAR_CON_UN_VALOR_ALEATORIO_NUEVO>
DEBUG=False
DATABASE_URL=postgresql://<USUARIO>:<PASSWORD>@<HOST>:<PUERTO>/<BASE>?sslmode=require
ALLOWED_HOSTS=tcysweb.lostocayos-lostcys.com.mx
CSRF_TRUSTED_ORIGINS=https://tcysweb.lostocayos-lostcys.com.mx
SCHEDULER_ENABLED=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
LOG_LEVEL=INFO
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<USUARIO_SMTP_OPCIONAL>
EMAIL_HOST_PASSWORD=<PASSWORD_SMTP_OPCIONAL>
DEFAULT_FROM_EMAIL=<REMITENTE_OPCIONAL>
ACTIVE_SESSION_TTL_SECONDS=600
